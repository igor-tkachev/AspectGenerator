<Project>
	<!-- Imported early by NuGet. Keep this file to defaults and compiler-visible properties only. -->
	<PropertyGroup>
		<AspectGeneratorInterceptorsNamespace Condition="'$(AspectGeneratorInterceptorsNamespace)' == ''">AspectGenerator</AspectGeneratorInterceptorsNamespace>

		<AspectGeneratorGenerateApi Condition="'$(AspectGeneratorGenerateApi)' == ''">true</AspectGeneratorGenerateApi>
		<AspectGeneratorPublicApi Condition="'$(AspectGeneratorPublicApi)' == ''">false</AspectGeneratorPublicApi>
		<AspectGeneratorDebuggerStepThrough Condition="'$(AspectGeneratorDebuggerStepThrough)' == ''">false</AspectGeneratorDebuggerStepThrough>
		<AspectGeneratorReportFile Condition="'$(AspectGeneratorReportFile)' == ''">$(BaseIntermediateOutputPath)\GeneratedFiles\AspectGenerator\AspectGeneratorBuildReport.md</AspectGeneratorReportFile>
		<AspectGeneratorAspectDiagnosticSeverity Condition="'$(AspectGeneratorAspectDiagnosticSeverity)' == ''">Info</AspectGeneratorAspectDiagnosticSeverity>
		<AspectGeneratorTrace Condition="'$(AspectGeneratorTrace)' == ''">false</AspectGeneratorTrace>
		<AspectGeneratorTraceLevel Condition="'$(AspectGeneratorTraceLevel)' == ''">Normal</AspectGeneratorTraceLevel>
	</PropertyGroup>

	<ItemGroup>
		<CompilerVisibleProperty Include="AspectGeneratorGenerateApi" />
		<CompilerVisibleProperty Include="AspectGeneratorPublicApi" />
		<CompilerVisibleProperty Include="AspectGeneratorDebuggerStepThrough" />
		<CompilerVisibleProperty Include="AspectGeneratorReportFile" />
		<CompilerVisibleProperty Include="AspectGeneratorAspectDiagnosticSeverity" />
		<CompilerVisibleProperty Include="AspectGeneratorTrace" />
		<CompilerVisibleProperty Include="AspectGeneratorTraceLevel" />
		<CompilerVisibleProperty Include="AspectGeneratorInterceptorsNamespace" />
		<CompilerVisibleProperty Include="CompilerGeneratedFilesOutputPath" />
		<CompilerVisibleProperty Include="Configuration" />
		<CompilerVisibleProperty Include="DesignTimeBuild" />
		<CompilerVisibleProperty Include="InterceptorsNamespaces" />
		<CompilerVisibleProperty Include="TargetFramework" />
	</ItemGroup>
</Project>
