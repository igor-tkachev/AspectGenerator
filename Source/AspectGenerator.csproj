<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>

		<Version>1.1.2</Version>
		<DevelopmentDependency>true</DevelopmentDependency>

		<IsPackage>true</IsPackage>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<Authors>Igor Tkachev</Authors>
		<Copyright>Igor Tkachev</Copyright>
		<PackageProjectUrl>https://github.com/igor-tkachev/AspectGenerator</PackageProjectUrl>
		<RepositoryUrl>https://github.com/igor-tkachev/AspectGenerator</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Aspect;AOP;AOP-like;SourceGenerator;C#;Interceptors;InterceptableLocation;CallSiteRewriting;CompileTime</PackageTags>
		<Description>AOP-like compile-time method aspects for C# interceptors without runtime proxies or IL weaving.</Description>
		<PackageLicenseFile>LICENSE.TXT</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<NoWarn>$(NoWarn);NU5128</NoWarn>

		<IsRoslynComponent>true</IsRoslynComponent>
	</PropertyGroup>

	<!--
	  The target filter parser is written in DotGram and generated ahead of the build: Source/TargetFilter/regenerate.sh
	  writes Source/TargetFilter/Generated, which is committed and compiled like any other source, so the build needs no
	  DotGram and the package gains no dependency. The grammar is an additional file so that the generation sees it.

	  -p:DotGramLocal=true builds the parser from the grammar instead, with the DotGram sources in $(DotGramRoot) as the
	  generator, and leaves the committed folder out; compare its output with the folder to try a DotGram change.
	-->
	<ItemGroup>
		<AdditionalFiles Include="TargetFilter\TargetFilter.gram" />
	</ItemGroup>

	<ItemGroup Condition="'$(DotGramLocal)' == 'true'">
		<Compile Remove="TargetFilter\Generated\**" />
		<ProjectReference Include="$(DotGramRoot)\src\DotGram\DotGram.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<!-- A project reference does not bring the package's build/DotGram.targets: take what it adds, as the package would. -->
	<Import Project="$(DotGramRoot)\src\DotGram\build\DotGram.targets" Condition="'$(DotGramLocal)' == 'true'" />

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp"    PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
		<PackageReference Include="PolySharp"                        PrivateAssets="all" />

		<!-- The host classification and the mode it selects have no public surface; the tests pin them directly. -->
		<InternalsVisibleTo Include="AspectGenerator.Tests" />

		<None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
		<None Include="build\AspectGenerator.props"                Pack="true" PackagePath="build\AspectGenerator.props" />
		<None Include="build\AspectGenerator.targets"              Pack="true" PackagePath="build\AspectGenerator.targets" />
		<None Include="buildTransitive\AspectGenerator.props"      Pack="true" PackagePath="buildTransitive\AspectGenerator.props" />
		<None Include="buildTransitive\AspectGenerator.targets"    Pack="true" PackagePath="buildTransitive\AspectGenerator.targets" />
		<None Include="..\LICENSE.TXT"                    Pack="true" PackagePath="\" />
		<None Include="..\README.md"                      Pack="true" PackagePath="\" />
		<None Include="..\Skills\aspectgenerator\**\*.md" Pack="true" PackagePath="skills/aspectgenerator/%(RecursiveDir)%(Filename)%(Extension)" />
		<None Include="..\CHANGELOG.md"                   Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
